{
  "name": "grokbot-control",
  "version": "0.1.0",
  "private": true,
  "description": "Programmable control plane for Grok Bot (shared SDK + CLI gbc + MCP). Not an official product.",
  "type": "module",
  "bin": {
    "gbc": "./dist/cli/main.js",
    "gbc-mcp": "./dist/mcp/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "gbc": "node dist/cli/main.js",
    "mcp": "node dist/mcp/main.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@bufbuild/protobuf": "1.10.1",
    "@connectrpc/connect": "1.6.1",
    "@connectrpc/connect-node": "1.6.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "imports": {
    "#proto-gen/GrokBotService": "./vendor/proto-gen/svc_aiserver.v1.GrokBotService_connect.js",
    "#proto-gen/aiserver": "./vendor/proto-gen/aiserver.v1_pb.js",
    "#proto-gen/agent": "./vendor/proto-gen/agent.v1_pb.js"
  }
}
