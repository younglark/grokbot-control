{
  "name": "grokbot-control-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/grokbot-control",
    "packages/local-exec-daemon",
    "packages/protocol"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test test/*.test.mjs",
    "generate": "npm run generate -w @grokbot-control/protocol",
    "generate:check": "npm run generate:check -w @grokbot-control/protocol",
    "test:protocol-tools": "python3 -m unittest discover -s tools/protocol",
    "smoke:uc": "npm run smoke:uc -w local-exec-daemon",
    "smoke:electron": "npm run smoke:electron -w local-exec-daemon",
    "dev:gbc": "npm run dev -w grokbot-control --",
    "dev:mcp": "npm run dev:mcp -w grokbot-control --",
    "gbc": "npm run gbc -w grokbot-control --",
    "mcp": "npm run mcp -w grokbot-control --",
    "prepublishOnly": "node -e \"throw new Error('Workspace root is private. Do not publish to npmjs; official GitHub install tags are minted by Actions after a v* tag is pushed.')\"",
    "verify:package": "node scripts/verify-package.mjs",
    "release:github": "node scripts/release-github.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "tree-sitter@0.21.1": true,
    "tree-sitter-bash@0.21.0": true
  }
}
