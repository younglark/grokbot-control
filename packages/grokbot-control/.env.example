# GBT_BASE_URL=https://api2.cursor.sh
# GBT_AUTH_KIND=cursor
# GBT_ALLOW_WRITES=1
# GBT_MOCK=1
# GBT_MOCK_STATE=/tmp/gbc-mock-state.json
# GBT_TRUST_BACKEND=1
# GBT_CREDENTIALS_DIR=~/.gbc
# GBT_MCP_READONLY=1
# GBT_OAUTH_CLIENT_ID=   # public OAuth client id for token refresh (not built in)
# GBT_WEBSITE_URL=https://cursor.com   # custom requires GBT_TRUST_BACKEND=1
# GBT_LOGIN_MODE=cli          # cli (default) or bot (App-style URL: sand + supportsSelectedTeamLogin=true)
# GBT_LOGIN_REDIRECT_TARGET=cli  # optional override of redirectTarget only; default follows GBT_LOGIN_MODE
