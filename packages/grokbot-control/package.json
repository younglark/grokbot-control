{
  "name": "grokbot-control",
  "version": "0.3.0",
  "description": "Programmable control plane for Grok Bot (shared SDK + CLI gbc + MCP). Not an official product.",
  "type": "module",
  "bin": {
    "gbc": "./dist/cli/main.js",
    "gbc-mcp": "./dist/mcp/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "vendor/proto-gen",
    "README.md"
  ],
  "scripts": {
    "dev": "node --import tsx src/cli/main.ts",
    "dev:mcp": "node --import tsx src/mcp/main.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-timeout=600000 test/*.test.ts",
    "gbc": "node dist/cli/main.js",
    "mcp": "node dist/mcp/main.js",
    "test:protocol-tools": "python3 -m unittest discover -s ../../tools/protocol",
    "generate": "node ../protocol/scripts/generate.cjs --target=control",
    "generate:check": "node ../protocol/scripts/generate.cjs --target=control --check"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/younglark/grokbot-control.git"
  },
  "bugs": {
    "url": "https://github.com/younglark/grokbot-control/issues"
  },
  "homepage": "https://github.com/younglark/grokbot-control#readme",
  "dependencies": {
    "@bufbuild/protobuf": "1.10.1",
    "@connectrpc/connect": "1.6.1",
    "@connectrpc/connect-node": "1.6.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "fs-native-extensions": "1.5.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "imports": {
    "#proto-gen/GrokBotService": "./vendor/proto-gen/svc_aiserver.v1.GrokBotService_connect.js",
    "#proto-gen/aiserver": "./vendor/proto-gen/aiserver.v1_pb.js",
    "#proto-gen/agent": "./vendor/proto-gen/agent.v1_pb.js"
  }
}
